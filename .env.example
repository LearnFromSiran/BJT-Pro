# =============================================================================
# BJT Pro — Japanese Letter to Nepali Explainer
# Copy this file to `.env.local` and fill in values.
#
# The app runs WITHOUT any keys in DEMO MODE (returns realistic sample
# analysis for uploaded letters). Add keys below to enable real OCR + AI.
# =============================================================================

# ---- OpenAI (structured extraction, Nepali explanation, reply drafts) -------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Primary cheap model + stronger fallback for low-confidence cases.
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o

# ---- Google Cloud Vision (OCR for Japanese/Nepali documents) ----------------
# Create an API key with Vision API enabled:
# https://cloud.google.com/vision/docs/setup
GOOGLE_VISION_API_KEY=

# ---- Supabase (auth, Postgres, storage) — OPTIONAL for MVP ------------------
# Without these, document history is kept locally in the browser.
# Create a project in the Tokyo (ap-northeast-1) region.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App config -------------------------------------------------------------
# Force demo mode even if keys are present (useful for screenshots/testing).
DEMO_MODE=false
